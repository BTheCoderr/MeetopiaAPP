# Signaling server URL (used by the Next.js client)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3003

# Public policy site (Netlify — no custom domain required)
NEXT_PUBLIC_SITE_URL=https://meetopia-live.netlify.app
NEXT_PUBLIC_SUPPORT_EMAIL=your-email@gmail.com

# Meetopia does not access Supabase directly from the browser.
# Durable application data is accessed server-side through Prisma/Postgres.
# Render-only report storage variables live in server/.env.example.

# Prisma / Postgres (Supabase → Settings → Database)
# DATABASE_URL=postgresql://...pooler...:6543/postgres?pgbouncer=true
# DATABASE_URL_UNPOOLED=postgresql://...:5432/postgres

# TURN server credentials (required for production / strict NAT networks)
# Leave blank for local development — STUN servers are sufficient on most home networks.
# Example providers: Twilio, Metered.ca, Xirsys
NEXT_PUBLIC_TURN_URL=turn:your-turn-server.com:3478
NEXT_PUBLIC_TURN_USERNAME=your-turn-username
NEXT_PUBLIC_TURN_CREDENTIAL=your-turn-credential

# Shared signing secret used by both the Next.js frontend and Render signaling server.
# Generate one long random value and configure the SAME value in Netlify + Render.
SOCKET_AUTH_SECRET=replace-with-a-long-random-secret

# Optional Netlify-safe override if an integration owns DATABASE_URL.
# Use the Supabase pooled PostgreSQL connection string.
MEETOPIA_DATABASE_URL=

# Password reset email (Netlify runtime)
RESEND_API_KEY=re_...
PASSWORD_RESET_FROM_EMAIL=Meetopia <onboarding@resend.dev>


# Safety report moderation notifications (Netlify runtime)
REPORT_NOTIFICATION_EMAIL=
REPORT_FROM_EMAIL=
