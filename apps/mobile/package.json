{
  "name": "meetopia-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client --scheme exp+meetopia-app",
    "start:dev": "expo start --dev-client --scheme exp+meetopia-app --tunnel",
    "start:lan": "expo start --dev-client --scheme exp+meetopia-app --lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --config .eslintrc.js --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@expo/ngrok": "^4.1.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~56.0.0",
    "expo-asset": "~56.0.0",
    "expo-constants": "~56.0.0",
    "expo-dev-client": "~56.0.0",
    "expo-font": "~56.0.0",
    "expo-linear-gradient": "~56.0.0",
    "expo-linking": "~56.0.0",
    "expo-router": "~56.0.0",
    "expo-status-bar": "~56.0.0",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-webrtc": "124.0.7",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.0",
    "eslint": "8.57.1",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "tar": "7.5.22",
    "uuid": "11.1.1",
    "postcss": "8.5.23",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2",
    "ajv": "8.18.0"
  }
}
