{
  "name": "meetopia-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client --scheme exp+meetopia-app",
    "start:dev": "expo start --dev-client --scheme exp+meetopia-app --tunnel",
    "start:lan": "expo start --dev-client --scheme exp+meetopia-app --lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "node ./scripts/lint.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@expo/ngrok": "^4.1.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-font": "~58.0.12",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "^4.16.0",
    "react-native-webrtc": "124.0.7",
    "react-native-worklets": "0.13.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.3.0",
    "eslint": "8.57.1",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "tar": "7.5.22",
    "uuid": "11.1.1",
    "postcss": "8.5.23",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2"
  }
}
