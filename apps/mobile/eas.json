{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.23.3",
      "ios": {
        "simulator": false,
        "image": "sdk-58"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.23.3",
      "ios": {
        "image": "sdk-58"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "node": "22.23.3",
      "env": {
        "MEETOPIA_DEPLOY_ENV": "staging",
        "EXPO_PUBLIC_STAGING": "true"
      },
      "ios": {
        "image": "sdk-58"
      }
    },
    "production": {
      "node": "22.23.3",
      "ios": {
        "image": "sdk-58"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "bferrell514@gmail.com",
        "ascAppId": "6747625372"
      }
    }
  }
